# Python関連
__pycache__/
*.py[cod]
*$py.class

# 仮想環境（venvを使用している場合）
venv/
.venv/
env/

# 環境変数・シークレット情報
# config.pyでOS環境変数を読み込む運用が基本ですが、
# もし .env ファイルを作成して管理している場合は必須です
.env
.env.*

# データベース関連
# SQLiteを使用している場合は、そのファイルを除外（PostgreSQLなら不要）
*.db
*.sqlite3

# OS生成ファイル
.DS_Store
Thumbs.db

# ログファイル
*.log

# ======================================================================
# アップロードされた投稿画像（improvement.md 第2版 項目 B-6）
# ======================================================================
# 本文画像・サムネイル専用画像は static/img/posts/ に UUID 名で保存される。
# これらは「ユーザーが投稿したコンテンツ」であってアプリのソースではないため、
# Git 追跡の対象にすると
#   ・手動配置した孤児ファイル（日本語名のスクリーンショット等）まで混入する
#   ・環境ごとに中身が食い違い、無用なコンフリクト・肥大化を招く
# ことになる。そこで posts/ の中身は追跡対象から外す。
#
# ただしディレクトリ自体はアプリが保存先として必要とするため、
# .gitkeep だけは追跡してディレクトリを残す
# （clone 直後は空だが、投稿すればこの中に画像が作られる）。
#
# ※ プリセットのデフォルトサムネイル（static/img/thbnails/ 配下の
#    system-default.jpg / thumb_option*.jpg）はアプリの同梱アセットなので
#    追跡対象のまま。ここでは除外しない。
static/img/posts/*
!static/img/posts/.gitkeep

# 【移行手順メモ】
# 既に posts/ の画像がコミット済みの場合、上の無視設定だけでは
# 追跡から外れない。以下で「ファイルは残したまま追跡だけ解除」する。
#   git rm -r --cached static/img/posts
#   touch static/img/posts/.gitkeep
#   git add static/img/posts/.gitkeep .gitignore
#   git commit -m "投稿画像を Git 追跡から除外（B-6）"
# 既存の日本語名スクリーンショット等は、上記の後に
#   flask clean-orphan-images          # まず一覧で確認
#   flask clean-orphan-images --delete # 参照の無いものを削除
# で整理できる。